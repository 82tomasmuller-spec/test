generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ───────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String
  role          String    @default("author") // admin, editor, author, viewer
  avatar        String?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  articles      Article[]
  auditLogs     AuditLog[]
  sessions      Session[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

// ─── Articles & Content ─────────────────────────────────────

model Article {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  content         String    // HTML content
  contentRaw      String?   // Raw editor content (JSON)
  excerpt         String?
  featuredImage   String?
  status          String    @default("draft") // draft, idea, in_progress, ready, scheduled, published, archived
  language        String    @default("cs")

  // SEO fields
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?

  // AI generation metadata
  aiGenerated     Boolean   @default(false)
  aiPrompt        String?
  writingStyle    String?
  targetAudience  String?

  // Scheduling
  publishAt       DateTime?
  publishedAt     DateTime?

  // Relations
  authorId        String
  author          User      @relation(fields: [authorId], references: [id])
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])

  tags            ArticleTag[]
  affiliateLinks  ArticleAffiliate[]
  versions        ArticleVersion[]
  faqItems        FAQItem[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([publishAt])
  @@index([slug])
}

model ArticleVersion {
  id        String   @id @default(cuid())
  articleId String
  title     String
  content   String
  version   Int
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  parentId    String?
  color       String    @default("#3b82f6")
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  articles    Article[]
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  createdAt DateTime     @default(now())
  articles  ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model FAQItem {
  id        String  @id @default(cuid())
  articleId String
  question  String
  answer    String
  sortOrder Int     @default(0)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

// ─── Affiliate Management ───────────────────────────────────

model AffiliatePartner {
  id          String   @id @default(cuid())
  name        String
  website     String?
  commission  String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  links       AffiliateLink[]
}

model AffiliateLink {
  id          String   @id @default(cuid())
  partnerId   String
  name        String
  url         String
  shortCode   String   @unique
  isActive    Boolean  @default(true)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  revenue     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  partner     AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  articles    ArticleAffiliate[]
  clickLogs   ClickLog[]
}

model ArticleAffiliate {
  articleId       String
  affiliateLinkId String
  placement       String?  // e.g., "cta", "inline", "sidebar"
  article         Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  affiliateLink   AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)

  @@id([articleId, affiliateLinkId])
}

model ClickLog {
  id              String   @id @default(cuid())
  affiliateLinkId String
  ip              String?
  userAgent       String?
  referer         String?
  createdAt       DateTime @default(now())

  affiliateLink   AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
}

// ─── Media ──────────────────────────────────────────────────

model Media {
  id          String   @id @default(cuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  altText     String?
  caption     String?
  path        String
  thumbnailPath String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Content Planning ───────────────────────────────────────

model ContentPlan {
  id          String   @id @default(cuid())
  title       String
  description String?
  keyword     String?
  status      String   @default("idea") // idea, planned, in_progress, ready, published
  priority    String   @default("medium") // low, medium, high
  plannedDate DateTime?
  assignedTo  String?
  articleId   String?  // linked article once created
  notes       String?
  color       String   @default("#3b82f6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── SEO ────────────────────────────────────────────────────

model SEOReport {
  id          String   @id @default(cuid())
  articleId   String?
  url         String?
  score       Int      @default(0)
  issues      String   // JSON array of issues
  suggestions String   // JSON array of suggestions
  createdAt   DateTime @default(now())
}

// ─── Settings ───────────────────────────────────────────────

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ─── Publication Log ────────────────────────────────────────

model PublicationLog {
  id        String   @id @default(cuid())
  articleId String
  action    String   // scheduled, published, unpublished
  details   String?
  createdAt DateTime @default(now())
}
